{
  "extends": [
    "@antfu",
    "@unocss"
  ],
  "rules": {
    "unused-imports/no-unused-imports": "off",
    "@asbjorn/groq/no-syntax-errors": [
      "error",
      { "groqs": ["@nuxtjs/sanity"] }
    ],
    "@asbjorn/groq/no-template-expressions": [
      "error",
      { "groqs": ["@nuxtjs/sanity"] }
    ]
  },
  "plugins": ["@asbjorn/groq"]
}
